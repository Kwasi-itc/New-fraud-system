# ==============================================================================
# PROJECT & DOCKER COMPOSE SETTINGS
# ==============================================================================
# The default project name. This defines the isolated environment folder in `.local/`
# Can be overridden via the `--project` flag in the setup script.
COMPOSE_PROJECT_NAME=new-fraud-system

# Docker Compose profiles to enable (e.g., local-idp, screening-worker)
COMPOSE_PROFILES=local-idp,screening-worker

# Custom network name (useful when running multiple instances to avoid collision)
FRAUD_INTERNAL_NETWORK=new-fraud-system_internal

# ==============================================================================
# DATABASE CONFIGURATION (EXTERNAL RDS)
# ==============================================================================
# REQUIRED: The main database connection string. The setup script will parse this
# to derive individual RDS_HOST, RDS_USER, etc., for Keycloak DB init.
DATABASE_URL=postgres://fraud:fraud@my-rds-endpoint.aws.com:5432/fraud?sslmode=require

# Optional: Separate database connections for read replicas or specific workers
# READ_DATABASE_URL=postgres://fraud:fraud@my-rds-read-replica.aws.com:5432/fraud?sslmode=require
# WORKER_DATABASE_URL=postgres://fraud:fraud@my-rds-endpoint.aws.com:5432/fraud?sslmode=require
# SCREENING_DELIVERY_DATABASE_URL=postgres://fraud:fraud@my-rds-endpoint.aws.com:5432/fraud?sslmode=require

# ==============================================================================
# ROUTING & PUBLIC ORIGINS (EC2 GATEWAY)
# ==============================================================================
# REQUIRED: The base URL where the EC2 gateway is externally reachable.
# Examples: http://203.0.113.50:8088  OR  https://fraud.yourdomain.com
# When using `docker-compose.gateway.ec2.yml`, this single variable automatically 
# configures allowed origins, frontend URLs, and Keycloak hostnames.
GATEWAY_PUBLIC_ORIGIN=http://localhost:8088

# The precise OIDC issuer URL expected by the auth-service. 
# This MUST match Keycloak's public address (usually GATEWAY_PUBLIC_ORIGIN + /identity/realms/fraud).
OIDC_ISSUER_URL=http://localhost:8088/identity/realms/fraud

# ==============================================================================
# IDENTITY & AUTHENTICATION
# ==============================================================================
# REQUIRED: The allowed tenant UUIDs for the case service integrations (comma-separated)
CASE_SERVICE_TENANT_IDS=00000000-0000-0000-0000-000000000000

# REQUIRED: The issuer of the JWT tokens used for service-to-service authentication
# (Matches the OIDC_ISSUER_URL above)
CASE_USER_JWT_ISSUER=http://localhost:8088/identity/realms/fraud

# REQUIRED: The path to the public keys used to verify incoming JWTs.
# (Defaults to .local/<project>/platform-public.json if left blank)
# CASE_USER_JWT_KEYS_FILE=./.local/new-fraud-system/platform-public.json

# Default tenant ID injected into the Frontend and Auth service
NEXT_PUBLIC_DATA_MODEL_TENANT_ID=00000000-0000-0000-0000-000000000000

# CRITICAL FOR EC2 HTTP TESTING: Secure cookies are disabled only for private,
# non-HTTPS testing. HTTP exposes session cookies to network interception.
# For HTTP set AUTH_COOKIE_SECURE=false and CASE_SESSION_COOKIE=fraud_session.
# For HTTPS keep AUTH_COOKIE_SECURE=true and use __Host-fraud_session.
CASE_SESSION_COOKIE=__Host-fraud_session
AUTH_COOKIE_SECURE=true

# ==============================================================================
# PORT CONFIGURATION (Avoid collisions when running multiple instances)
# ==============================================================================
# The main gateway port (Can be overridden via the `--port` flag)
POSTGRES_GATEWAY_PORT=8088

# NOTE: Ensure your AWS Security Group blocks external access to the following 
# internal backend ports. External traffic should only enter via POSTGRES_GATEWAY_PORT.
# Service-specific host ports (increment these for subsequent instances, e.g., 3100, 8180)
FRONTEND_FORWARDED_PORT=3000
DATA_MODEL_FORWARDED_PORT=8080
INGESTION_FORWARDED_PORT=8081
DECISION_ENGINE_FORWARDED_PORT=8082
SCREENING_FORWARDED_PORT=8085
CASE_MANAGER_FORWARDED_PORT=8086
KEYCLOAK_FORWARDED_PORT=8090
KEYCLOAK_BIND_ADDRESS=127.0.0.1

# ==============================================================================
# SECURITY TOKENS
# ==============================================================================
# If left blank, the setup script will automatically generate 32-byte hex strings.
SERVICE_AUTH_TOKEN=
CASE_SERVICE_AUTH_TOKEN=
WORKFLOW_AUTHORING_TOKEN=
SCREENING_AUTHORING_TOKEN=
SCREENING_INTAKE_TOKEN=
SCREENING_CALLBACK_TOKEN=
SCREENING_OPERATOR_TOKEN=

# ==============================================================================
# APPLICATION TUNING & LOGGING (OPTIONAL)
# ==============================================================================
DECISION_ENGINE_LOG_LEVEL=debug
CASE_LOG_LEVEL=info

# DB Pools
# INGESTION_DATABASE_MAX_CONNS=10
# DECISION_DATABASE_MAX_CONNS=10
# CASE_DB_POOL_MAX_CONNS=8

# Feature Flags
# LIVE_DECISION_MODE=sync
# LIVE_ASYNC_FALLBACK_ENABLED=false
# TENANT_DATA_READ_MODE=ingestion_http