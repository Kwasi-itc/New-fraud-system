# Build from the repository root (or from backend/screening-service if extracted).
# Runs scheduled live PEP scrapers and imports snapshots directly into the
# standalone provider catalog via /app/source-import.
FROM golang:1.27.4 AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src/screening-service
COPY backend/screening-service/go.mod backend/screening-service/go.sum ./
COPY backend/investigator ../investigator
RUN go mod download
COPY backend/screening-service/ ./
ENV CGO_ENABLED=0 GOFLAGS=-buildvcs=false
RUN GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -mod=readonly -trimpath -o /out/source-import ./cmd/source-import

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates \
    && pip3 install --no-cache-dir --break-system-packages scrapling curl_cffi \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/work
COPY --from=builder /out/source-import /app/source-import
COPY backend/screening-service/scripts/pep/ /app/scripts/pep/
RUN mkdir -p /app/work && chown -R 65532:65532 /app
USER 65532:65532
ENV HOME=/tmp
ENV PEP_WORK_DIR=/app/work
ENV SCREENING_PYTHON=python3
ENTRYPOINT ["node", "/app/scripts/pep/refresh-standalone-provider.mjs", "--direct-import"]
