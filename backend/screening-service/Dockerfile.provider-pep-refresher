# Build from the repository root (after fraud-screening-provider:dev is built).
# Runs scheduled live PEP scrapers and imports snapshots directly into the
# standalone provider catalog via /app/source-import.
FROM fraud-screening-provider:dev AS provider_bins

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates postgresql-client \
    && pip3 install --no-cache-dir --break-system-packages scrapling curl_cffi \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/work
COPY --from=provider_bins /app/source-import /app/source-import
COPY backend/screening-service/scripts/pep/ /app/scripts/pep/
RUN mkdir -p /app/work && chown -R 65532:65532 /app
USER 65532:65532
ENV HOME=/tmp
ENV PEP_WORK_DIR=/app/work
ENV SCREENING_PYTHON=python3
ENTRYPOINT ["node", "/app/scripts/pep/refresh-standalone-provider.mjs", "--direct-import"]
