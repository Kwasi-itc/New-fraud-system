# Direct local execution. The standalone Compose file supplies its own
# container-internal DATABASE_URL.
PORT=8080
DATABASE_URL=postgres://datamodel:datamodel@localhost:5434/datamodel?sslmode=disable
SERVICE_AUTH_MODE=disabled
SERVICE_AUTH_TOKEN=
SERVICE_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
GIN_MODE=debug
INDEX_WORKER_MAX_ATTEMPTS=5
INDEX_JOB_QUEUE_NAME=index_jobs
INDEX_JOB_QUEUE_WORKERS=4
DATA_MODEL_FORWARDED_PORT=8080
