    "normalized_query": "WITH queries AS MATERIALIZED(SELECT screening.name_key_v1(name) AS key,type,query FROM (VALUES ($4::text,$5::text,$6::jsonb)) AS j(name,type,query))\n SELECT c.owner_scope,c.dataset_id,c.generation,c.record_id,c.entity_id,c.record,c.original,c.fuzzy_name,q.key,q.query,c.similarity\n FROM (VALUES ($1::uuid,$2::text,$3::uuid)) AS d(owner,dataset,generation)\n CROSS JOIN queries q\n CROSS JOIN LATERAL (\n SELECT r.owner_scope,r.dataset_id,r.generation,r.record_id,r.entity_id,r.record-$8 AS record,n.original,n.fuzzy_name,public.similarity(n.fuzzy_name,q.key) AS similarity\n FROM screening.source_names n\n JOIN screening.source_records r ON(r.owner_scope,r.dataset_id,r.generation,r.record_id)=(n.owner_scope,n.dataset_id,n.generation,n.record_id)\n WHERE(n.owner_scope,n.dataset_id,n.generation)=(d.owner,d.dataset,d.generation) AND n.fuzzy_name OPERATOR(public.%) q.key AND r.entity_type=q.type\n ORDER BY public.similarity(n.fuzzy_name,q.key) DESC,r.entity_id,n.original LIMIT $7\n ) c\n ORDER BY c.similarity DESC,c.entity_id,c.original,q.key LIMIT $7",
