# Server and primary database
PORT=8081
DATABASE_URL=postgres://ingestion:ingestion@localhost:5435/ingestion?sslmode=disable
DATABASE_MAX_CONNS=12
DATABASE_MIN_CONNS=2
DATA_MODEL_SERVICE_URL=http://localhost:8080

# Service-to-service auth and HTTP behavior
SERVICE_AUTH_MODE=disabled
SERVICE_AUTH_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
GIN_MODE=debug
HTTP_CLIENT_TIMEOUT=10s

# Optional isolated query and worker pools. Empty URLs reuse DATABASE_URL.
READ_DATABASE_URL=
READ_DATABASE_MAX_CONNS=0
READ_DATABASE_MIN_CONNS=0
WORKER_DATABASE_URL=
WORKER_DATABASE_MAX_CONNS=4
WORKER_DATABASE_MIN_CONNS=0

# Worker queues
WORKER_MAX_ATTEMPTS=3
UPLOAD_LOG_QUEUE_NAME=upload_logs
UPLOAD_LOG_QUEUE_WORKERS=4
DEFERRED_INGEST_QUEUE_NAME=deferred_ingests
DEFERRED_INGEST_QUEUE_WORKERS=4

# Request and query pressure controls
WRITE_PATH_CONCURRENCY_LIMIT=200
WRITE_PATH_OVERLOAD_MODE=defer_async
READ_QUERY_CONCURRENCY_LIMIT=64
AGGREGATE_QUERY_CONCURRENCY_LIMIT=0
AGGREGATE_QUERY_TIMEOUT=3s
DB_POOL_SATURATION_THRESHOLD_PCT=80
REQUEST_QUEUE_DEPTH_THRESHOLD=8
SERVICE_CPU_THRESHOLD_PCT=80
UPSTREAM_TIMEOUT_RATE_THRESHOLD_PCT=5

# Required aggregate-fact store
AGGREGATE_FACT_REDIS_URL=redis://localhost:6379/0
VALKEY_APPENDONLY=no
VALKEY_APPENDFSYNC=no
