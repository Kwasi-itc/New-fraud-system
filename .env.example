# Root Docker/system configuration.
# Copy this file to .env and adjust it for the deployment environment.
# Keep replay-specific values such as TRANSACTIONS, MULTIPLIER, TENANT_ID,
# TRANSACTION_OFFSET, DATA_ROOT, and SEED_DATA_ROOT on the make command line.

# Public service address and forwarded host ports
NEXT_PUBLIC_SERVICE_BASE_URL=http://localhost
FRONTEND_FORWARDED_PORT=3000
DATA_MODEL_FORWARDED_PORT=8080
INGESTION_FORWARDED_PORT=8081
DECISION_ENGINE_FORWARDED_PORT=8082
SCREENING_FORWARDED_PORT=8085
POSTGRES_FORWARDED_PORT=5432

# Shared backend process settings
SERVICE_AUTH_MODE=disabled
SERVICE_AUTH_TOKEN=
LOG_LEVEL=info
DECISION_LOG_LEVEL=debug
GIN_MODE=debug
HTTP_CLIENT_TIMEOUT=10s

# PostgreSQL tuning applied by the root Compose stack. Keep synchronous commit
# enabled when acknowledged writes must survive a database or host crash.
POSTGRES_MAX_WAL_SIZE=32GB
POSTGRES_MIN_WAL_SIZE=2GB
POSTGRES_CHECKPOINT_TIMEOUT=15min
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_WAL_COMPRESSION=on
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_BGWRITER_LRU_MAXPAGES=1000
POSTGRES_SYNCHRONOUS_COMMIT=on

# Aggregate-fact cache persistence. These defaults intentionally make Valkey
# memory-only; PostgreSQL remains the durable source of truth for backfilling.
VALKEY_APPENDONLY=no
VALKEY_APPENDFSYNC=no

# Optional tenant opened by the frontend by default
NEXT_PUBLIC_DATA_MODEL_TENANT_ID=

# PostgreSQL connection pools
INGESTION_DATABASE_MAX_CONNS=12
INGESTION_DATABASE_MIN_CONNS=2
DECISION_DATABASE_MAX_CONNS=24
DECISION_DATABASE_MIN_CONNS=4
DECISION_WORKER_DATABASE_MAX_CONNS=6
DECISION_WORKER_DATABASE_MIN_CONNS=1

# Data-model index queue
INDEX_WORKER_MAX_ATTEMPTS=5
INDEX_JOB_QUEUE_NAME=index_jobs
INDEX_JOB_QUEUE_WORKERS=4

# Optional isolated pools. Leave the URLs empty to reuse the primary database.
READ_DATABASE_URL=
READ_DATABASE_MAX_CONNS=0
READ_DATABASE_MIN_CONNS=0
WORKER_DATABASE_URL=
WORKER_DATABASE_MAX_CONNS=4
WORKER_DATABASE_MIN_CONNS=0

# Ingestion pressure controls
WRITE_PATH_CONCURRENCY_LIMIT=100000
WRITE_PATH_OVERLOAD_MODE=defer_async
READ_QUERY_CONCURRENCY_LIMIT=64
AGGREGATE_QUERY_CONCURRENCY_LIMIT=0
AGGREGATE_QUERY_TIMEOUT=3s
INGESTION_WORKER_MAX_ATTEMPTS=3
UPLOAD_LOG_QUEUE_NAME=upload_logs
UPLOAD_LOG_QUEUE_WORKERS=4
DEFERRED_INGEST_QUEUE_NAME=deferred_ingests
DEFERRED_INGEST_QUEUE_WORKERS=4
DB_POOL_SATURATION_THRESHOLD_PCT=80
REQUEST_QUEUE_DEPTH_THRESHOLD=8
SERVICE_CPU_THRESHOLD_PCT=80
UPSTREAM_TIMEOUT_RATE_THRESHOLD_PCT=5

# Decision execution and aggregate-read behavior
AGGREGATE_PUSHDOWN_MODE=enabled
AGGREGATE_PUSHDOWN_AGGREGATES=count,sum,avg
LIVE_DECISION_MODE=sync
LIVE_ASYNC_FALLBACK_ENABLED=false
LIVE_ASYNC_OBJECT_TYPES=
LIVE_DECISION_CONCURRENCY_LIMIT=0
TENANT_DATA_READ_MODE=direct_db
RULE_EVALUATION_CONCURRENCY=0
SCENARIO_EVALUATION_CONCURRENCY=0
AGGREGATE_REMOTE_CONCURRENCY_LIMIT=0
SCHEDULED_EXECUTION_MAX_ATTEMPTS=3
SCHEDULED_EXECUTION_RETRY_BACKOFF=30s
SCHEDULED_EXECUTION_QUEUE_NAME=scheduled_executions
SCHEDULED_EXECUTION_QUEUE_WORKERS=4
ASYNC_EXECUTION_MAX_ATTEMPTS=3
ASYNC_EXECUTION_RETRY_BACKOFF=30s
ASYNC_EXECUTION_DEFAULT_WAIT_WINDOW=300ms
ASYNC_EXECUTION_MAX_WAIT_WINDOW=1s
ASYNC_EXECUTION_CALLBACK_TIMEOUT=5s
ASYNC_EXECUTION_CALLBACK_MAX_ATTEMPTS=5
ASYNC_EXECUTION_CALLBACK_QUEUE_NAME=async_decision_execution_callbacks
ASYNC_EXECUTION_CALLBACK_QUEUE_WORKERS=2
ASYNC_EXECUTION_CALLBACK_SIGNING_SECRET=
ASYNC_EXECUTION_QUEUE_NAME=async_decision_executions
ASYNC_EXECUTION_QUEUE_WORKERS=4
WORKFLOW_DISPATCH_QUEUE_NAME=workflow_executions
WORKFLOW_DISPATCH_QUEUE_WORKERS=4
SCREENING_DISPATCH_QUEUE_NAME=screening_executions
SCREENING_DISPATCH_QUEUE_WORKERS=4
SCORING_DISPATCH_QUEUE_NAME=scoring_requests
SCORING_DISPATCH_QUEUE_WORKERS=4
OUTBOX_QUEUE_NAME=outbox_events
OUTBOX_QUEUE_WORKERS=4
WORKFLOW_ACTION_URL=
SCREENING_PROVIDER_URL=
SCORING_PROVIDER_URL=
OUTBOX_PUBLISHER_URL=
DECISION_WORKER_MODE=poll
DECISION_WORKER_POLL_INTERVAL=15s
DECISION_WORKER_BATCH_LIMIT=100
DECISION_WORKER_TASKS=scheduled,async,workflow_dispatch,screening_dispatch,scoring_dispatch,outbox
DECISION_WORKER_TASK_PRIORITIES=

# Aggregate facts
# Reserved for a later phase. Current services do not read this setting, so
# changing it has no effect in this release.
EVENT_AGGREGATE_FACTS_ENABLED=
AGGREGATE_FACT_REDIS_URL=redis://valkey:6379/0

# Valkey persistence
# The safe default uses an append-only file and fsyncs once per second. For an
# explicitly disposable performance test, set both values to no; losing Valkey
# data then makes fact-backed decisions unavailable until a backfill completes.
VALKEY_APPENDONLY=yes
VALKEY_APPENDFSYNC=everysec
