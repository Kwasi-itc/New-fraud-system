ENV_FILE ?= $(firstword $(wildcard .env))
ifneq ($(strip $(ENV_FILE)),)
include $(ENV_FILE)
endif
REPLAY_ENV_FILE := $(if $(strip $(ENV_FILE)),$(abspath $(ENV_FILE)),)

