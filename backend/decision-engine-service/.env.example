# Server
PORT=8082
GIN_MODE=debug
LOG_LEVEL=info

# Required service dependencies
DATABASE_URL=postgres://datamodel:datamodel@localhost:5434/datamodel?sslmode=disable
DATA_MODEL_SERVICE_URL=http://localhost:8080
INGESTION_SERVICE_URL=http://localhost:8081

# Optional local MMDB geolocation (required only by IPGeo* rule functions)
GEOIP_MMDB_PATH=
GEOIP_LOCALE=en

# Service-to-service auth
# Explicit local-only opt-out; omitted mode defaults to token and requires a secret.
# See ../auth-service/LEGACY_API_AUTH.md for coordinated deployment requirements.
SERVICE_AUTH_MODE=disabled
SERVICE_AUTH_TOKEN=
# Private workflow gateway/operator credential, at least 32 bytes. Also set on
# the frontend server; never expose through NEXT_PUBLIC variables.
WORKFLOW_AUTHORING_TOKEN=
# Private screening gateway/operator credential, at least 32 bytes.
# Also configure on the frontend server, never in browser-visible variables.
# Distinct from SERVICE_AUTH_TOKEN; never expose through NEXT_PUBLIC variables.
# Empty disables legacy screening-config CRUD and execution read/status/retry routes,
# including when service auth is disabled. Operators send X-Screening-Authoring-Token
# in addition to the configured service bearer credential.
SCREENING_AUTHORING_TOKEN=
SERVICE_ALLOWED_ORIGINS=http://localhost:3000

# Optional downstream integrations
WORKFLOW_ACTION_URL=
SCREENING_SERVICE_URL=
SCREENING_PROVIDER_URL=
SCORING_PROVIDER_URL=
OUTBOX_PUBLISHER_URL=

# HTTP client behavior
HTTP_CLIENT_TIMEOUT=10s
ASYNC_EXECUTION_DEFAULT_WAIT_WINDOW=300ms
ASYNC_EXECUTION_MAX_WAIT_WINDOW=1s
ASYNC_EXECUTION_CALLBACK_TIMEOUT=5s
ASYNC_EXECUTION_CALLBACK_MAX_ATTEMPTS=5
ASYNC_EXECUTION_CALLBACK_QUEUE_NAME=async_decision_execution_callbacks
ASYNC_EXECUTION_CALLBACK_QUEUE_WORKERS=2
ASYNC_EXECUTION_CALLBACK_SIGNING_SECRET=

# Worker behavior
# Worker mode:
# - batch: process one cycle and exit
# - poll: keep running and poll on an interval
WORKER_MODE=poll
WORKER_POLL_INTERVAL=15s
WORKER_BATCH_LIMIT=100

# Dedicated internal integration credentials, >=32 characters and distinct from
# each other, SERVICE_AUTH_TOKEN and operator/gateway credentials. No fallback.
# Configure the same respective values on both APIs and workers; never frontend.
SCREENING_INTAKE_TOKEN=
SCREENING_CALLBACK_TOKEN=

# Optional Marble-compatible POST text -> [{type,text}] name recognition.
# HTTPS required except loopback test endpoints; never sent to the browser.
SCREENING_NAME_RECOGNITION_URL=
SCREENING_NAME_RECOGNITION_TOKEN=
