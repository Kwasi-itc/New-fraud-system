# syntax=docker/dockerfile:1
FROM golang:1.25.8 AS build
WORKDIR /backend/decision-engine-service
COPY mysqlstore ../mysqlstore
COPY investigator ../investigator
COPY auth-service ../auth-service
COPY case-manager-service ../case-manager-service
COPY data-model-service ../data-model-service
COPY screening-service ../screening-service
COPY decision-engine-service ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -mod=readonly -o /bin/install-decisions ./cmd/mysql-dev-install
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -mod=readonly -o /bin/mysql-api ./cmd/mysql-api
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -mod=readonly -o /bin/mysql-provider ./cmd/mysql-local-provider
FROM gcr.io/distroless/base-debian12
COPY --from=build /bin/install-decisions /app/install-decisions
COPY --from=build /bin/mysql-api /app/mysql-api
COPY --from=build /bin/mysql-provider /app/mysql-provider
EXPOSE 8082
CMD ["/app/mysql-api"]
