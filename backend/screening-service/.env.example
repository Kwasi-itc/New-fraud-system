PORT=8085
# Private owner secret, at least 32 characters and distinct from SERVICE_AUTH_TOKEN.
# Empty disables the entire legacy /v1 owner group, including disabled-auth mode.
# Manual search and investigator APIs retain their independent identity checks.
# Operators send X-Screening-Operator-Token plus the configured service bearer.
# The server-side case-evidence gateway also needs it after authorizing case access.
# Never provide this secret to browser, provider or normal worker configuration.
SCREENING_OPERATOR_TOKEN=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marble_screening?sslmode=disable
# Explicit local-only opt-out; omitted mode defaults to token and requires a secret.
# See ../auth-service/LEGACY_API_AUTH.md for coordinated deployment requirements.
SERVICE_AUTH_MODE=disabled
SERVICE_AUTH_TOKEN=
SCREENING_PROVIDER_URL=http://localhost:8090
SCREENING_PROVIDER_URLS=opensanctions=http://localhost:8090,motiva=http://localhost:8091
OPENSANCTIONS_API_HOST=
OPENSANCTIONS_AUTH_METHOD=
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_SCOPE=default
OPENSANCTIONS_ALGORITHM=logic-v1
INGESTION_SERVICE_URL=http://localhost:8081
INBOX_SERVICE_URL=http://localhost:8086
CASE_SERVICE_URL=http://localhost:8087
BLOB_SERVICE_URL=http://localhost:8088
DECISION_ENGINE_URL=http://localhost:8084
LOG_LEVEL=info
GIN_MODE=debug
HTTP_CLIENT_TIMEOUT=10s
WORKER_MODE=batch
WORKER_POLL_INTERVAL=15s
WORKER_BATCH_LIMIT=100

# Dedicated internal integration credentials, >=32 characters and distinct from
# each other, SERVICE_AUTH_TOKEN and operator/gateway credentials. No fallback.
# Configure the same respective values on both APIs and workers; never frontend.
SCREENING_INTAKE_TOKEN=
SCREENING_CALLBACK_TOKEN=
