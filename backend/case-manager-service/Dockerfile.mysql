# syntax=docker/dockerfile:1
FROM golang:1.25.8 AS build
WORKDIR /backend/case-manager-service
COPY mysqlstore ../mysqlstore
COPY investigator ../investigator
COPY auth-service ../auth-service
COPY data-model-service ../data-model-service
COPY decision-engine-service ../decision-engine-service
COPY screening-service ../screening-service
COPY case-manager-service ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -mod=readonly -o /bin/mysql-api ./cmd/mysql-api
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -mod=readonly -o /bin/install-case ./cmd/mysql-dev-install
FROM gcr.io/distroless/base-debian12
COPY --from=build /bin/mysql-api /app/mysql-api
COPY --from=build /bin/install-case /app/install-case
USER 65532:65532
EXPOSE 8086
CMD ["/app/mysql-api"]
