PORT=8086
# Same logical database as data-model and the other fraud services.
# case_manager is this service's schema, not a separate database.
DATABASE_URL=postgres://fraud:fraud@localhost:5432/fraud?sslmode=disable
SERVICE_AUTH_MODE=disabled
SERVICE_AUTH_TOKEN=
DECISION_ENGINE_URL=http://localhost:8082
SCREENING_SERVICE_URL=http://localhost:8085
INGESTION_SERVICE_URL=http://localhost:8081
DATA_MODEL_SERVICE_URL=http://localhost:8080
BLOB_SERVICE_URL=
OUTBOX_PUBLISHER_URL=
LOG_LEVEL=info
# Compose uses CASE_LOG_LEVEL from the workspace-root .env for API and worker.
# Set CASE_LOG_LEVEL=debug there for request/transaction/idle maintenance details.
GIN_MODE=debug
HTTP_CLIENT_TIMEOUT=10s
WORKER_MODE=batch
WORKER_POLL_INTERVAL=15s
WORKER_BATCH_LIMIT=100
